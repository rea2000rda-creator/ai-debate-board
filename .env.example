# คัดลอกไฟล์นี้เป็น .env แล้วใส่ API key ของแพลตฟอร์มที่มี
# ใส่เฉพาะตัวที่มี — ตัวที่เว้นว่างไว้จะไม่ถูกเรียกใช้ในกระดาน

# OpenAI (platform.openai.com/api-keys)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Google Gemini (aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Anthropic (console.anthropic.com)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# พอร์ตที่จะรันเซิร์ฟเวอร์
PORT=3000

# กุญแจเข้าถึง API endpoint (/api/v1/debate) — ตั้งไว้เพื่อกันคนอื่นยิงมาใช้โควต้า API ของคุณฟรีๆ
# โปรแกรม/AI ที่เรียกใช้ต้องแนบ header: Authorization: Bearer <ค่านี้>
# ถ้าเว้นว่างไว้ = ไม่มีการล็อก ใครก็เรียกได้ (ไม่แนะนำถ้าจะเปิดเป็นเว็บสาธารณะ)
API_ACCESS_KEY=
